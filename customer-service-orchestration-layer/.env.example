# Required for the server and scripts/mcp_smoke.py; no default token is accepted.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Inject the same value into the server and MCP client environments.
# Docker Compose loads .env automatically; bare Python does not.
# For a bare Python server/client, export it in your shell or use your deployment.
# Keep real values in ignored local files or your deployment secret store.
CSOL_BEARER_TOKEN=

# Optional for bare Python. Compose fixes this to /app/data/csol.sqlite3 and
# bind-mounts ./data; this host override does not change the container path.
# Default for bare Python: data/csol.sqlite3 in this repository.
# Relative paths resolve from the server's working directory. Use one server process.
CSOL_DB_PATH=./data/csol.sqlite3

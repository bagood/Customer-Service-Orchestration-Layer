# Required for the server and scripts/mcp_smoke.py; no default token is accepted.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Inject the same value into the server and MCP client environments.
# .env is not loaded automatically. Export it in your shell or use your deployment.
# Keep real values in ignored local files or your deployment secret store.
CSOL_BEARER_TOKEN=

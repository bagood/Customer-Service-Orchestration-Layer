MCP_SERVER_NAME="Python MCP Template"
# Docker Compose host port; the container always listens on port 8000.
MCP_PORT=8000
# JSON arrays; add your deployment hostname/origin when hosting remotely.
MCP_ALLOWED_HOSTS='["127.0.0.1:*", "localhost:*", "[::1]:*", "mcp:8000"]'
MCP_ALLOWED_ORIGINS='["http://127.0.0.1:*", "http://localhost:*", "http://[::1]:*"]'
# Intent decision model: provider's API base URL, including /v1 when required.
# MCP_LLM_BASE_URL=https://your-provider.example/v1
# MCP_LLM_MODEL=your-model-name
# MCP_LLM_API_KEY=replace-with-your-provider-key
MCP_LLM_TIMEOUT_SECONDS=20
# Use json_schema when your chosen provider/model supports strict JSON Schema.
MCP_LLM_RESPONSE_FORMAT=json_object

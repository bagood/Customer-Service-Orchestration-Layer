# Use the URL-encoded password from .secrets/redis_password.
REDIS_URL=redis://csol:replace_me@redis:6379/0
# Use the URL-encoded password from .secrets/postgres_app_password.
DATABASE_URL=postgresql://csol_app:replace_me@postgres:5432/csol
# Generate with python -c "import secrets; print(secrets.token_hex(32))"
CSOL_BINDING_KEY=
